@using Inventra.WebUI.Dtos.UserDtos
@model UserDetailDto

@{
    var firstName = Model?.FirstName ?? "";
    var lastName = Model?.LastName ?? "";
    var userName = Model?.UserName ?? "-";
    var email = Model?.Email ?? "-";

    var avatar = !string.IsNullOrWhiteSpace(firstName)
        ? firstName[..1].ToUpper()
        : "?";

    var fullName = string.IsNullOrWhiteSpace(firstName + lastName)
        ? "-"
        : $"{firstName} {lastName}".Trim();
}

<div class="page-header d-flex justify-content-between align-items-center mb-4">

    <div>

        <h2 class="fw-bold mb-1">
            <i class="bi bi-person-circle text-primary"></i>
            Kullanıcı Detayı
        </h2>

        <p class="text-muted mb-0">
            Kullanıcı bilgilerini görüntüleyin.
        </p>

    </div>

    <a asp-action="Index"
       class="btn btn-outline-secondary">

        <i class="bi bi-arrow-left"></i>

        Kullanıcılara Dön

    </a>

</div>

<div class="row">

    <div class="col-lg-4">

        <div class="content-card text-center">

            <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center mx-auto mb-3"
                 style="width:90px;height:90px;font-size:34px;font-weight:700;">

                @avatar

            </div>

            <h4 class="mb-1">

                @fullName

            </h4>

            <p class="text-muted mb-3">

                @userName

            </p>

            <span class="badge bg-success">

                Aktif Kullanıcı

            </span>

            <hr />

            <div class="text-start">

                <div class="mb-3">

                    <small class="text-muted">

                        Email

                    </small>

                    <div class="fw-semibold">

                        @email

                    </div>

                </div>

                <div>

                    <small class="text-muted">

                        Kullanıcı Adı

                    </small>

                    <div class="fw-semibold">

                        @userName

                    </div>

                </div>

            </div>

        </div>

    </div>

    <div class="col-lg-8">

        <div class="content-card">

            <h5 class="fw-semibold mb-4">

                <i class="bi bi-person-vcard text-primary"></i>

                Genel Bilgiler

            </h5>

            <div class="row">

                <div class="col-md-6 mb-4">

                    <label class="form-label">

                        Ad

                    </label>

                    <input class="form-control"
                           value="@firstName"
                           readonly />

                </div>

                <div class="col-md-6 mb-4">

                    <label class="form-label">

                        Soyad

                    </label>

                    <input class="form-control"
                           value="@lastName"
                           readonly />

                </div>

                <div class="col-md-6 mb-4">

                    <label class="form-label">

                        Kullanıcı Adı

                    </label>

                    <input class="form-control"
                           value="@userName"
                           readonly />

                </div>

                <div class="col-md-6 mb-4">

                    <label class="form-label">

                        Email

                    </label>

                    <input class="form-control"
                           value="@email"
                           readonly />

                </div>

            </div>

        </div>

    </div>

</div>