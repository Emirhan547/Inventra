@using Inventra.WebUI.Common
@using Inventra.WebUI.Dtos.UserDtos

@model PagedResponse<ResultUserDto>

<div class="page-header d-flex justify-content-between align-items-center mb-4">

    <div>

        <h2 class="fw-bold mb-1">

            <i class="bi bi-people-fill text-primary"></i>

            Kullanıcı Yönetimi

        </h2>

        <p class="text-muted mb-0">

            Sisteme kayıtlı kullanıcıları görüntüleyin ve yönetin.

        </p>

    </div>

    <div>

        <span class="badge bg-primary fs-6 p-3">

            Toplam @Model.Items.Count Kullanıcı

        </span>

    </div>

</div>

<div class="content-card">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <h5 class="mb-0 fw-semibold">

            Kullanıcı Listesi

        </h5>

        <div style="width:300px">

            <input type="text"
                   class="form-control"
                   placeholder="Kullanıcı ara...">

        </div>

    </div>

    <div class="table-responsive">

        <table class="table align-middle table-hover">

            <thead class="table-light">

                <tr>

                    <th>Kullanıcı</th>

                    <th>E-Posta</th>

                    <th class="text-end">

                        İşlemler

                    </th>

                </tr>

            </thead>

            <tbody>

                @foreach (var item in Model.Items)
                {
                    <tr>

                        <td>

                            <div class="d-flex align-items-center">

                                <div class="rounded-circle bg-primary text-white fw-bold d-flex justify-content-center align-items-center me-3"
                                     style="width:42px;height:42px;">

                                    @item.UserName.Substring(0, 1).ToUpper()

                                </div>

                                <div>

                                    <div class="fw-semibold">

                                        @item.UserName

                                    </div>

                                    <small class="text-muted">

                                        Sistem Kullanıcısı

                                    </small>

                                </div>

                            </div>

                        </td>

                        <td>

                            @item.Email

                        </td>

                        <td class="text-end">

                            <a asp-action="Details"
                               asp-route-id="@item.Id"
                               class="btn btn-outline-info btn-sm">

                                <i class="bi bi-eye"></i>

                                Detay

                            </a>

                            <a asp-action="Roles"
                               asp-route-id="@item.Id"
                               class="btn btn-primary btn-sm">

                                <i class="bi bi-person-gear"></i>

                                Roller

                            </a>

                        </td>

                    </tr>
                }

            </tbody>

        </table>

    </div>

</div>