@using Inventra.WebUI.Common
@using Inventra.WebUI.Dtos.ProductDtos

@model PagedResponse<ResultProductDto>

@{
    ViewData["Title"] = "Ürünler";
}

<div class="page-header">

    <div>

        <h2>Ürünler</h2>

        <p class="text-muted mb-0">

            Toplam <strong>@Model.TotalCount</strong> ürün bulunmaktadır.

        </p>

    </div>

    <a asp-action="Create"
       class="btn btn-primary">

        <i class="bi bi-plus-lg me-2"></i>

        Yeni Ürün

    </a>

</div>

<div class="content-card mb-4">

    <form method="get">

        <div class="row g-3 align-items-end">

            <div class="col-lg-5">

                <label class="form-label fw-semibold">

                    Ürün Ara

                </label>

                <input type="text"
                       name="Search"
                       value="@Context.Request.Query["Search"]"
                       class="form-control"
                       placeholder="Ürün adı veya SKU..." />

            </div>

            <div class="col-lg-4">

                <label class="form-label fw-semibold">

                    Kategori

                </label>

                <select name="CategoryId"
                        asp-items="ViewBag.Categories"
                        class="form-select">

                    <option value="">
                        Tüm Kategoriler
                    </option>

                </select>

            </div>

            <div class="col-lg-3">

                <div class="d-flex gap-2">

                    <button type="submit"
                            class="btn btn-primary flex-fill">

                        <i class="bi bi-funnel me-2"></i>

                        Filtrele

                    </button>

                    <a asp-action="Index"
                       class="btn btn-outline-secondary">

                        <i class="bi bi-arrow-clockwise"></i>

                    </a>

                </div>

            </div>

        </div>

    </form>

</div>

<div class="content-card">

    @if (Model.Items.Any())
    {
        <div class="table-responsive">

            <table class="table table-hover align-middle inventory-table">

                <thead>

                    <tr>

                        <th>Kategori</th>

                        <th>Ürün Adı</th>

                        <th>SKU</th>

                        <th class="text-end">Fiyat</th>

                        <th class="text-center">Min. Stok</th>

                        <th class="text-end" style="width:220px">

                            İşlemler

                        </th>

                    </tr>

                </thead>

                <tbody>

                    @foreach (var item in Model.Items)
                    {
                        <tr>

                            <td>

                                <span class="badge bg-light text-dark border">

                                    @item.CategoryName

                                </span>

                            </td>

                            <td class="fw-semibold">

                                @item.Name

                            </td>

                            <td>

                                <code>@item.SKU</code>

                            </td>

                            <td class="text-end fw-semibold">

                                @item.UnitPrice.ToString("C")

                            </td>

                            <td class="text-center">

                                @item.MinimumStockLevel

                            </td>

                            <td class="text-end">

                                <div class="d-inline-flex gap-2">

                                    <a asp-action="Update"
                                       asp-route-id="@item.Id"
                                       class="btn btn-outline-primary btn-sm">

                                        <i class="bi bi-pencil-square me-1"></i>

                                        Düzenle

                                    </a>

                                    <a asp-action="Delete"
                                       asp-route-id="@item.Id"
                                       class="btn btn-outline-danger btn-sm">

                                        <i class="bi bi-trash me-1"></i>

                                        Sil

                                    </a>

                                </div>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>
    }
    else
    {
        <div class="text-center py-5">

            <i class="bi bi-box-seam display-5 text-primary"></i>

            <h4 class="mt-3">

                Ürün bulunamadı

            </h4>

            <p class="text-muted">

                Arama kriterlerinize uygun ürün bulunmamaktadır.

            </p>

        </div>
    }

</div>

@if (Model.TotalPages > 1)
{
    <nav class="mt-4">

        <ul class="pagination justify-content-center">

            <li class="page-item @(Model.PageNumber == 1 ? "disabled" : "")">

                <a class="page-link"
                   asp-action="Index"
                   asp-route-PageNumber="@(Model.PageNumber - 1)"
                   asp-route-PageSize="@Model.PageSize"
                   asp-route-Search="@Context.Request.Query["Search"]"
                   asp-route-CategoryId="@Context.Request.Query["CategoryId"]">

                    <i class="bi bi-chevron-left"></i>

                </a>

            </li>

            @for (int i = 1; i <= Model.TotalPages; i++)
            {
                <li class="page-item @(i == Model.PageNumber ? "active" : "")">

                    <a class="page-link"
                       asp-action="Index"
                       asp-route-PageNumber="@i"
                       asp-route-PageSize="@Model.PageSize"
                       asp-route-Search="@Context.Request.Query["Search"]"
                       asp-route-CategoryId="@Context.Request.Query["CategoryId"]">

                        @i

                    </a>

                </li>
            }

            <li class="page-item @(Model.PageNumber == Model.TotalPages ? "disabled" : "")">

                <a class="page-link"
                   asp-action="Index"
                   asp-route-PageNumber="@(Model.PageNumber + 1)"
                   asp-route-PageSize="@Model.PageSize"
                   asp-route-Search="@Context.Request.Query["Search"]"
                   asp-route-CategoryId="@Context.Request.Query["CategoryId"]">

                    <i class="bi bi-chevron-right"></i>

                </a>

            </li>

        </ul>

    </nav>
}