@using Inventra.WebUI.Dtos.DashboardDtos
@model DashboardSummaryDto

<div class="dash-header">
    <div>
        <h1>Dashboard</h1>
        <p>Inventra Envanter Yönetim Sistemi — Genel Durum</p>
    </div>
    <div class="dash-badge">
        <span class="dot"></span>
        Sistem Aktif
    </div>
</div>

<!-- Stat Grid -->
<div class="stat-grid">

    <div class="stat-card sc-blue">
        <div class="stat-icon">📦</div>
        <div>
            <h3>@Model.TotalProducts</h3>
            <span>Toplam Ürün</span>
        </div>
    </div>

    <div class="stat-card sc-purple">
        <div class="stat-icon">🏢</div>
        <div>
            <h3>@Model.TotalWarehouses</h3>
            <span>Toplam Depo</span>
        </div>
    </div>

    <div class="stat-card sc-green">
        <div class="stat-icon">📊</div>
        <div>
            <h3>@Model.TotalStocks</h3>
            <span>Stok Kaydı</span>
        </div>
    </div>

    <div class="stat-card sc-cyan">
        <div class="stat-icon">🔄</div>
        <div>
            <h3>@Model.TotalStockMovements</h3>
            <span>Stok Hareketi</span>
        </div>
    </div>

    <div class="stat-card sc-amber">
        <div class="stat-icon">🤝</div>
        <div>
            <h3>@Model.TotalSuppliers</h3>
            <span>Tedarikçi</span>
        </div>
    </div>

    <div class="stat-card sc-orange">
        <div class="stat-icon">🛒</div>
        <div>
            <h3>@Model.TotalPurchaseOrders</h3>
            <span>Satın Alma Siparişi</span>
        </div>
    </div>

    <div class="stat-card sc-red">
        <div class="stat-icon">⏳</div>
        <div>
            <h3>@Model.PendingPurchaseOrders</h3>
            <span>Bekleyen Talep</span>
        </div>
    </div>

    <div class="stat-card sc-rose">
        <div class="stat-icon">⚠️</div>
        <div>
            <h3>@Model.CriticalStockCount</h3>
            <span>Kritik Stok</span>
        </div>
    </div>

</div>

<!-- Main Grid: Quick Actions | Movements | Critical Stocks -->
<div class="dash-main-grid">

    <!-- Quick Actions -->
    <div class="content-card">
        <div class="dash-card-header">
            <h4 class="dash-card-title">
                <span class="title-dot"></span>
                Hızlı İşlemler
            </h4>
        </div>
        <div class="quick-actions">
            <a asp-controller="Product" asp-action="Create" class="qa-btn qa-blue">
                <span class="qa-icon">📦</span>
                Yeni Ürün Ekle
                <span class="qa-arrow">→</span>
            </a>
            <a asp-controller="Supplier" asp-action="Create" class="qa-btn qa-green">
                <span class="qa-icon">🤝</span>
                Yeni Tedarikçi
                <span class="qa-arrow">→</span>
            </a>
            <a asp-controller="Stock" asp-action="StockIn" class="qa-btn qa-amber">
                <span class="qa-icon">📥</span>
                Stok Girişi
                <span class="qa-arrow">→</span>
            </a>
            <a asp-controller="Stock" asp-action="StockOut" class="qa-btn qa-red">
                <span class="qa-icon">📤</span>
                Stok Çıkışı
                <span class="qa-arrow">→</span>
            </a>
            <a asp-controller="PurchaseOrder" asp-action="Create" class="qa-btn qa-purple">
                <span class="qa-icon">🛒</span>
                Satın Alma Siparişi
                <span class="qa-arrow">→</span>
            </a>
        </div>
    </div>

    <!-- Recent Movements -->
    <div class="content-card">
        <div class="dash-card-header">
            <h4 class="dash-card-title">
                <span class="title-dot"></span>
                Son Stok Hareketleri
            </h4>
            <span class="dash-card-badge">Son 10</span>
        </div>

        @if (Model.RecentMovements.Any())
        {
            <table class="dash-table">
                <thead>
                    <tr>
                        <th>Ürün</th>
                        <th>Depo</th>
                        <th>Tip</th>
                        <th>Miktar</th>
                        <th>Tarih</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.RecentMovements)
                    {
                        <tr>
                            <td>@item.ProductName</td>
                            <td>@item.WarehouseName</td>
                            <td>
                                @if (item.Type?.ToLower().Contains("giriş") == true || item.Type?.ToLower() == "in")
                                {
                                    <span class="badge-in">↑ @item.Type</span>
                                }
                                else
                                {
                                    <span class="badge-out">↓ @item.Type</span>
                                }
                            </td>
                            <td>@item.Quantity</td>
                            <td>@item.CreatedDate.ToString("dd.MM.yyyy HH:mm")</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <div class="empty-state">
                <div class="empty-icon">📭</div>
                Henüz stok hareketi yok
            </div>
        }
    </div>

    <!-- Critical Stocks -->
    <div class="content-card">
        <div class="dash-card-header">
            <h4 class="dash-card-title">
                <span class="title-dot" style="background:var(--accent-red)"></span>
                Kritik Stoklar
            </h4>
            @if (Model.CriticalStocks.Any())
            {
                <span class="dash-card-badge" style="color:var(--accent-red);border-color:rgba(239,68,68,.3)">
                    @Model.CriticalStocks.Count() adet
                </span>
            }
        </div>

        @if (Model.CriticalStocks.Any())
        {
            <table class="dash-table">
                <thead>
                    <tr>
                        <th>Ürün</th>
                        <th>Depo</th>
                        <th>Mevcut</th>
                        <th>Min.</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.CriticalStocks)
                    {
                        var pct = item.MinimumStockLevel > 0
                            ? (int)Math.Min(100, (item.Quantity * 100.0 / item.MinimumStockLevel))
                            : 0;
                        <tr>
                            <td>@item.ProductName</td>
                            <td>@item.WarehouseName</td>
                            <td>
                                <div class="stock-bar-wrap">
                                    <span>@item.Quantity</span>
                                    <div class="stock-bar-bg">
                                        <div class="stock-bar-fill" style="width:@(pct)%"></div>
                                    </div>
                                </div>
                            </td>
                            <td style="color:var(--accent-red)">@item.MinimumStockLevel</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <div class="empty-state">
                <div class="empty-icon">✅</div>
                Kritik stok yok
            </div>
        }
    </div>

</div>

<!-- Chart -->
<div class="content-card mt-4">
    <div class="dash-card-header">
        <h4 class="dash-card-title">
            <span class="title-dot" style="background:var(--accent-purple)"></span>
            Son 7 Günlük Stok Hareketleri
        </h4>
    </div>
    <canvas id="movementChart"></canvas>
</div>

@section Scripts
{
    <script>
        const labels = [
            @Html.Raw(string.Join(",", Model.MovementChart.Select(x => $"'{x.Date}'")))
        ];
        const stockIn  = [@string.Join(",", Model.MovementChart.Select(x => x.StockInCount))];
        const stockOut = [@string.Join(",", Model.MovementChart.Select(x => x.StockOutCount))];

        const ctx = document.getElementById("movementChart").getContext("2d");

        const gradIn = ctx.createLinearGradient(0, 0, 0, 200);
        gradIn.addColorStop(0, "rgba(22,163,74,.85)");
        gradIn.addColorStop(1, "rgba(22,163,74,.25)");

        const gradOut = ctx.createLinearGradient(0, 0, 0, 200);
        gradOut.addColorStop(0, "rgba(220,38,38,.85)");
        gradOut.addColorStop(1, "rgba(220,38,38,.25)");

        new Chart(ctx, {
            type: "bar",
            data: {
                labels,
                datasets: [
                    {
                        label: "Stok Giriş",
                        data: stockIn,
                        backgroundColor: gradIn,
                        borderColor: "#16a34a",
                        borderWidth: 1,
                        borderRadius: 6,
                        borderSkipped: false
                    },
                    {
                        label: "Stok Çıkış",
                        data: stockOut,
                        backgroundColor: gradOut,
                        borderColor: "#dc2626",
                        borderWidth: 1,
                        borderRadius: 6,
                        borderSkipped: false
                    }
                ]
            },
            options: {
                responsive: true,
                plugins: {
                    legend: {
                        labels: {
                            color: "#6b7280",
                            font: { size: 12 },
                            usePointStyle: true,
                            pointStyleWidth: 8
                        }
                    },
                    tooltip: {
                        backgroundColor: "#ffffff",
                        borderColor: "#e5e7eb",
                        borderWidth: 1,
                        titleColor: "#111827",
                        bodyColor: "#6b7280",
                        padding: 12,
                        cornerRadius: 8
                    }
                },
                scales: {
                    x: {
                        grid: { color: "rgba(51,65,85,.5)" },
                        ticks: { color: "#9ca3af", font: { size: 11 } }
                    },
                    y: {
                        grid: { color: "rgba(51,65,85,.5)" },
                        ticks: { color: "#9ca3af", font: { size: 11 } },
                        beginAtZero: true
                    }
                }
            }
        });
    </script>
}
