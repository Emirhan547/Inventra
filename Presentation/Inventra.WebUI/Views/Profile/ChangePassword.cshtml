@using Inventra.WebUI.Dtos.ProfileDtos

@model ChangePasswordDto

<div class="page-header">
    <div>
        <h2>
            Şifre Değiştir
        </h2>

        <p class="text-muted">
            Hesabınızın güvenliği için güçlü bir şifre kullanın.
        </p>
    </div>
</div>

<form asp-action="ChangePassword"
      method="post">
    <div class="content-card">
        <div asp-validation-summary="ModelOnly"
             class="text-danger mb-3">
        </div>

        <div class="mb-3">
            <label asp-for="CurrentPassword"
                   class="form-label">
            </label>

            <div class="input-group">
                <input asp-for="CurrentPassword"
                       id="currentPassword"
                       type="password"
                       class="form-control" />

                <button class="btn btn-outline-secondary"
                        type="button"
                        aria-label="Mevcut şifreyi göster veya gizle"
                        onclick="togglePassword('currentPassword', this)">
                    Göster
                </button>
            </div>

            <span asp-validation-for="CurrentPassword"
                  class="text-danger">
            </span>
        </div>

        <div class="mb-3">
            <label asp-for="NewPassword"
                   class="form-label">
            </label>

            <div class="input-group">
                <input asp-for="NewPassword"
                       id="newPassword"
                       type="password"
                       class="form-control" />

                <button class="btn btn-outline-secondary"
                        type="button"
                        aria-label="Yeni şifreyi göster veya gizle"
                        onclick="togglePassword('newPassword', this)">
                    Göster
                </button>
            </div>

            <span asp-validation-for="NewPassword"
                  class="text-danger">
            </span>
        </div>

        <div class="mb-4">
            <label asp-for="ConfirmPassword"
                   class="form-label">
            </label>

            <div class="input-group">
                <input asp-for="ConfirmPassword"
                       id="confirmPassword"
                       type="password"
                       class="form-control" />

                <button class="btn btn-outline-secondary"
                        type="button"
                        aria-label="Yeni şifre tekrarını göster veya gizle"
                        onclick="togglePassword('confirmPassword', this)">
                    Göster
                </button>
            </div>

            <span asp-validation-for="ConfirmPassword"
                  class="text-danger">
            </span>
        </div>

        <div class="d-flex gap-2">
            <button type="submit"
                    class="btn btn-warning">
                Şifreyi Güncelle
            </button>

            <a asp-action="Index"
               class="btn btn-secondary">
                Vazgeç
            </a>
        </div>
    </div>
</form>

<div class="content-card mt-4">
    <h5>
        Güvenlik Önerileri
    </h5>

    <hr />

    <ul class="mb-0">
        <li>En az 8 karakter kullanın.</li>
        <li>Büyük ve küçük harf birlikte kullanın.</li>
        <li>En az bir rakam ekleyin.</li>
        <li>Mümkünse özel karakter kullanın.</li>
        <li>Daha önce kullandığınız şifreleri tekrar kullanmayın.</li>
    </ul>
</div>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />

    <script>
        function togglePassword(id, button) {
            const input = document.getElementById(id);
            const isPassword = input.type === "password";

            input.type = isPassword ? "text" : "password";
            button.textContent = isPassword ? "Gizle" : "Göster";
        }
    </script>
}
