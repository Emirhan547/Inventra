@model Inventra.WebUI.Dtos.PurchaseOrders.CompletePurchaseOrderDto

@{
    ViewData["Title"] =
        "Siparişi Tamamla";
}

<div class="content-card">

    <h2 class="mb-4">

        Siparişi Tamamla

    </h2>

    <p class="text-muted">

        Sipariş teslim alındığında
        ürünler seçilen depoya
        aktarılacaktır.

    </p>

    <form asp-action="Complete"
          method="post">

        <input asp-for="PurchaseOrderId"
               type="hidden" />

        <div class="mb-3">

            <label asp-for="WarehouseId"
                   class="form-label">

                Depo

            </label>

            <select asp-for="WarehouseId"
                    asp-items="ViewBag.Warehouses"
                    class="form-select">

                <option value="">

                    Depo Seçiniz

                </option>

            </select>

            <span asp-validation-for="WarehouseId"
                  class="text-danger">
            </span>

        </div>

        <button type="submit"
                class="btn btn-success">

            Teslim Al ve Stoğa İşle

        </button>

    </form>

</div>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}