@using Inventra.WebUI.Common
@using Inventra.WebUI.Dtos.StockMovementDtos

@model PagedResponse<ResultStockMovementDto>

@{
    ViewData["Title"] = "Stok Hareketleri";
}

<div class="page-header">

    <div>

        <h2>Stok Hareketleri</h2>

        <p class="text-muted mb-0">

            Toplam <strong>@Model.TotalCount</strong> hareket bulunmaktadır.

        </p>

    </div>

</div>

<div class="content-card mb-4">

    <form method="get">

        <div class="row g-3 align-items-end">

            <div class="col-lg-3">

                <label class="form-label fw-semibold">

                    Hareket Tipi

                </label>

                <select name="Type"
                        class="form-select">

                    <option value="">
                        Tüm Hareketler
                    </option>

                    <option value="1"
                            selected="@(Context.Request.Query["Type"] == "1")">

                        Stok Girişi

                    </option>

                    <option value="2"
                            selected="@(Context.Request.Query["Type"] == "2")">

                        Stok Çıkışı

                    </option>

                    <option value="3"
                            selected="@(Context.Request.Query["Type"] == "3")">

                        Transfer

                    </option>

                    <option value="4"
                            selected="@(Context.Request.Query["Type"] == "4")">

                        Düzeltme

                    </option>

                </select>

            </div>

            <div class="col-lg-3">

                <label class="form-label fw-semibold">

                    Başlangıç Tarihi

                </label>

                <input type="date"
                       name="StartDate"
                       value="@Context.Request.Query["StartDate"]"
                       class="form-control" />

            </div>

            <div class="col-lg-3">

                <label class="form-label fw-semibold">

                    Bitiş Tarihi

                </label>

                <input type="date"
                       name="EndDate"
                       value="@Context.Request.Query["EndDate"]"
                       class="form-control" />

            </div>

            <div class="col-lg-3">

                <div class="d-flex gap-2">

                    <button class="btn btn-primary flex-fill">

                        <i class="bi bi-funnel me-2"></i>

                        Filtrele

                    </button>

                    <a asp-action="Index"
                       class="btn btn-outline-secondary">

                        <i class="bi bi-arrow-clockwise"></i>

                    </a>

                </div>

            </div>

        </div>

    </form>

</div>

<div class="content-card">

    @if (Model.Items.Any())
    {
        <div class="table-responsive">

            <table class="table table-hover align-middle inventory-table">

                <thead>

                    <tr>

                        <th>Tarih</th>

                        <th>Ürün</th>

                        <th>Depo</th>

                        <th>Hareket</th>

                        <th class="text-center">Miktar</th>

                        <th>Açıklama</th>

                    </tr>

                </thead>

                <tbody>

                    @foreach (var item in Model.Items)
                    {
                        <tr>

                            <td>

                                @item.CreatedDate.ToString("dd.MM.yyyy")

                                <br />

                                <small class="text-muted">

                                    @item.CreatedDate.ToString("HH:mm")

                                </small>

                            </td>

                            <td class="fw-semibold">

                                @item.ProductName

                            </td>

                            <td>

                                @item.WarehouseName

                            </td>

                            <td>

                                @switch (item.Type)
                                {
                                    case StockMovementType.StockIn:

                                        <span class="badge bg-success">
                                            Giriş
                                        </span>

                                        break;

                                    case StockMovementType.StockOut:

                                        <span class="badge bg-danger">
                                            Çıkış
                                        </span>

                                        break;

                                    case StockMovementType.Transfer:

                                        <span class="badge bg-primary">
                                            Transfer
                                        </span>

                                        break;

                                    case StockMovementType.Adjustment:

                                        <span class="badge bg-warning text-dark">
                                            Düzeltme
                                        </span>

                                        break;
                                }

                            </td>

                            <td class="text-center fw-semibold">

                                @item.Quantity

                            </td>

                            <td>

                                @(string.IsNullOrWhiteSpace(item.Description)
                                    ? "-"
                                    : item.Description)

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>
    }
    else
    {
        <div class="text-center py-5">

            <i class="bi bi-clock-history display-5 text-primary"></i>

            <h4 class="mt-3">

                Hareket bulunamadı

            </h4>

            <p class="text-muted">

                Seçilen filtrelere uygun stok hareketi bulunmamaktadır.

            </p>

        </div>
    }

</div>

@if (Model.TotalPages > 1)
{
    <nav class="mt-4">

        <ul class="pagination justify-content-center">

            <li class="page-item @(Model.PageNumber == 1 ? "disabled" : "")">

                <a class="page-link"
                   asp-action="Index"
                   asp-route-PageNumber="@(Model.PageNumber - 1)"
                   asp-route-PageSize="@Model.PageSize"
                   asp-route-Type="@Context.Request.Query["Type"]"
                   asp-route-StartDate="@Context.Request.Query["StartDate"]"
                   asp-route-EndDate="@Context.Request.Query["EndDate"]">

                    <i class="bi bi-chevron-left"></i>

                </a>

            </li>

            @for (int i = 1; i <= Model.TotalPages; i++)
            {
                <li class="page-item @(i == Model.PageNumber ? "active" : "")">

                    <a class="page-link"
                       asp-action="Index"
                       asp-route-PageNumber="@i"
                       asp-route-PageSize="@Model.PageSize"
                       asp-route-Type="@Context.Request.Query["Type"]"
                       asp-route-StartDate="@Context.Request.Query["StartDate"]"
                       asp-route-EndDate="@Context.Request.Query["EndDate"]">

                        @i

                    </a>

                </li>
            }

            <li class="page-item @(Model.PageNumber == Model.TotalPages ? "disabled" : "")">

                <a class="page-link"
                   asp-action="Index"
                   asp-route-PageNumber="@(Model.PageNumber + 1)"
                   asp-route-PageSize="@Model.PageSize"
                   asp-route-Type="@Context.Request.Query["Type"]"
                   asp-route-StartDate="@Context.Request.Query["StartDate"]"
                   asp-route-EndDate="@Context.Request.Query["EndDate"]">

                    <i class="bi bi-chevron-right"></i>

                </a>

            </li>

        </ul>

    </nav>
}