@using Inventra.WebUI.Dtos.WarehouseDtos
@model List<ResultWarehouseDto>

@{
    ViewData["Title"] = "Depolar";
}

<div class="page-header">

    <div>

        <h2>
            Depolar
        </h2>

        <p class="text-muted mb-0">

            Toplam <strong>@Model.Count</strong> depo bulunmaktadır.

        </p>

    </div>

    <a asp-action="Create"
       class="btn btn-primary">

        <i class="bi bi-plus-lg me-2"></i>

        Yeni Depo

    </a>

</div>

<div class="content-card">

    @if (Model.Any())
    {
        <div class="table-responsive">

            <table class="table table-hover align-middle inventory-table">

                <thead>

                    <tr>

                        <th>Depo Adı</th>

                        <th>Lokasyon</th>

                        <th class="text-end" style="width:220px">

                            İşlemler

                        </th>

                    </tr>

                </thead>

                <tbody>

                    @foreach (var item in Model)
                    {
                        <tr>

                            <td class="fw-semibold">

                                @item.Name

                            </td>

                            <td>

                                @item.Location

                            </td>

                            <td class="text-end">

                                <div class="d-inline-flex gap-2">

                                    <a asp-action="Update"
                                       asp-route-id="@item.Id"
                                       class="btn btn-outline-primary btn-sm">

                                        <i class="bi bi-pencil-square me-1"></i>

                                        Düzenle

                                    </a>

                                    <a asp-action="Delete"
                                       asp-route-id="@item.Id"
                                       class="btn btn-outline-danger btn-sm">

                                        <i class="bi bi-trash me-1"></i>

                                        Sil

                                    </a>

                                </div>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>
    }
    else
    {
        <div class="text-center py-5">

            <i class="bi bi-building display-5 text-primary"></i>

            <h4 class="mt-3">

                Henüz depo bulunmuyor

            </h4>

            <p class="text-muted">

                İlk deponuzu oluşturarak başlayabilirsiniz.

            </p>

            <a asp-action="Create"
               class="btn btn-primary mt-2">

                <i class="bi bi-plus-lg me-2"></i>

                İlk Depoyu Oluştur

            </a>

        </div>
    }

</div>