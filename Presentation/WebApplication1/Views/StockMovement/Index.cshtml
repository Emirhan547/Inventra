@using Inventra.WebUI.Common
@using Inventra.WebUI.Dtos.StockMovementDtos
@model PagedResponse<ResultStockMovementDto>

<div class="page-header">

    <div>

        <h2>Stok Hareketleri</h2>

        <p class="text-muted">
            Tüm stok hareketleri
        </p>

    </div>

</div>

<form method="get" class="mb-4">

    <div class="row g-2">

        <div class="col-md-3">

            <select name="Type"
                    class="form-select">

                <option value="">
                    Tüm Hareketler
                </option>

                <option value="1"
                        selected="@(Context.Request.Query["Type"] == "1")">

                    Stok Girişi

                </option>

                <option value="2"
                        selected="@(Context.Request.Query["Type"] == "2")">

                    Stok Çıkışı

                </option>

                <option value="3"
                        selected="@(Context.Request.Query["Type"] == "3")">

                    Transfer

                </option>

            </select>

        </div>

        <div class="col-md-3">

            <input type="date"
                   name="StartDate"
                   value="@Context.Request.Query["StartDate"]"
                   class="form-control" />

        </div>

        <div class="col-md-3">

            <input type="date"
                   name="EndDate"
                   value="@Context.Request.Query["EndDate"]"
                   class="form-control" />

        </div>

        <div class="col-md-3 d-flex gap-2">

            <button type="submit"
                    class="btn btn-primary">

                Filtrele

            </button>

            <a asp-action="Index"
               class="btn btn-outline-secondary">

                Temizle

            </a>

        </div>

    </div>

</form>

<div class="content-card">

    <table class="table table-hover align-middle">

        <thead>

            <tr>

                <th>Tarih</th>

                <th>Ürün</th>

                <th>Depo</th>

                <th>Tip</th>

                <th>Miktar</th>

                <th>Açıklama</th>

            </tr>

        </thead>

        <tbody>

            @if (Model.Items.Any())
            {
                @foreach (var item in Model.Items)
                {
                    <tr>

                        <td>
                            @item.CreatedDate.ToString("dd.MM.yyyy HH:mm")
                        </td>

                        <td>
                            @item.ProductName
                        </td>

                        <td>
                            @item.WarehouseName
                        </td>

                        <td>

                            @switch (item.Type)
                            {
                                case StockMovementType.StockIn:

                                    <span class="badge bg-success">
                                        Giriş
                                    </span>
                                    break;

                                case StockMovementType.StockOut:

                                    <span class="badge bg-danger">
                                        Çıkış
                                    </span>
                                    break;

                                case StockMovementType.Transfer:

                                    <span class="badge bg-primary">
                                        Transfer
                                    </span>
                                    break;

                                case StockMovementType.Adjustment:

                                    <span class="badge bg-warning text-dark">
                                        Düzeltme
                                    </span>
                                    break;
                            }

                        </td>

                        <td>
                            @item.Quantity
                        </td>

                        <td>
                            @item.Description
                        </td>

                    </tr>
                }
            }
            else
            {
                <tr>

                    <td colspan="6"
                        class="text-center">

                        Hareket bulunamadı

                    </td>

                </tr>
            }

        </tbody>

    </table>

</div>

@if (Model.TotalPages > 1)
{
    <nav class="mt-4">

        <ul class="pagination justify-content-center">

            <li class="page-item @(Model.PageNumber == 1 ? "disabled" : "")">

                <a class="page-link"
                   asp-action="Index"
                   asp-route-PageNumber="@(Model.PageNumber - 1)"
                   asp-route-PageSize="@Model.PageSize"
                   asp-route-Type="@Context.Request.Query["Type"]"
                   asp-route-StartDate="@Context.Request.Query["StartDate"]"
                   asp-route-EndDate="@Context.Request.Query["EndDate"]">

                    Önceki

                </a>

            </li>

            @for (int i = 1; i <= Model.TotalPages; i++)
            {
                <li class="page-item @(i == Model.PageNumber ? "active" : "")">

                    <a class="page-link"
                       asp-action="Index"
                       asp-route-PageNumber="@i"
                       asp-route-PageSize="@Model.PageSize"
                       asp-route-Type="@Context.Request.Query["Type"]"
                       asp-route-StartDate="@Context.Request.Query["StartDate"]"
                       asp-route-EndDate="@Context.Request.Query["EndDate"]">

                        @i

                    </a>

                </li>
            }

            <li class="page-item @(Model.PageNumber == Model.TotalPages ? "disabled" : "")">

                <a class="page-link"
                   asp-action="Index"
                   asp-route-PageNumber="@(Model.PageNumber + 1)"
                   asp-route-PageSize="@Model.PageSize"
                   asp-route-Type="@Context.Request.Query["Type"]"
                   asp-route-StartDate="@Context.Request.Query["StartDate"]"
                   asp-route-EndDate="@Context.Request.Query["EndDate"]">

                    Sonraki

                </a>

            </li>

        </ul>

    </nav>
}