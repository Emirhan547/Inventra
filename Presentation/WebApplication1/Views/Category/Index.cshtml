@using Inventra.WebUI.Dtos.CategoryDtos
@model List<ResultCategoryDto>

@{
    ViewData["Title"] = "Kategoriler";
}

<div class="page-header">

    <div>

        <h2 class="mb-1">

            <i class="bi bi-tags-fill text-primary me-2"></i>

            Kategoriler

        </h2>

        <p class="text-muted mb-0">

            Toplam <strong>@Model.Count</strong> kategori bulunmaktadır.

        </p>

    </div>

    <a asp-controller="Category"
       asp-action="Create"
       class="btn btn-primary">

        <i class="bi bi-plus-lg me-2"></i>

        Yeni Kategori

    </a>

</div>

<div class="content-card">

    @if (Model.Any())
    {
        <div class="table-responsive">

            <table class="table table-hover align-middle inventory-table">

                <thead>

                    <tr>

                        <th style="width:70px">
                            #
                        </th>

                        <th>
                            Kategori Adı
                        </th>

                        <th class="text-end"
                            style="width:240px">

                            İşlemler

                        </th>

                    </tr>

                </thead>

                <tbody>

                    @for (int i = 0; i < Model.Count; i++)
                    {
                        <tr>

                            <td class="text-muted fw-semibold">

                                @(i + 1)

                            </td>

                            <td>

                                <span class="fw-semibold fs-6">

                                    @Model[i].Name

                                </span>

                            </td>

                            <td class="text-end">

                                <div class="d-inline-flex gap-2">

                                    <a asp-controller="Category"
                                       asp-action="Update"
                                       asp-route-id="@Model[i].Id"
                                       class="btn btn-outline-primary btn-sm">

                                        <i class="bi bi-pencil-square me-1"></i>

                                        Düzenle

                                    </a>

                                    <a asp-controller="Category"
                                       asp-action="Delete"
                                       asp-route-id="@Model[i].Id"
                                       class="btn btn-outline-danger btn-sm">

                                        <i class="bi bi-trash me-1"></i>

                                        Sil

                                    </a>

                                </div>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>
    }
    else
    {

        <div class="text-center py-5">

            <i class="bi bi-tags display-4 text-primary"></i>

            <h4 class="mt-4">

                Henüz kategori bulunmuyor

            </h4>

            <p class="text-muted">

                İlk kategorinizi oluşturarak başlayabilirsiniz.

            </p>

            <a asp-controller="Category"
               asp-action="Create"
               class="btn btn-primary mt-2">

                <i class="bi bi-plus-lg me-2"></i>

                İlk Kategoriyi Oluştur

            </a>

        </div>

    }

</div>