@using Inventra.WebUI.Common
@using Inventra.WebUI.Dtos.StockDtos

@model PagedResponse<ResultStockDto>

<div class="page-header">

    <div>

        <h2>Stoklar</h2>

        <p class="text-muted">
            AI destekli stok analizi
        </p>

    </div>

</div>

<div class="content-card">

    <table class="table table-hover align-middle">

        <thead>

            <tr>

                <th>Ürün</th>
                <th>Depo</th>
                <th>Mevcut Stok</th>
                <th>30 Gün Tahmini</th>
                <th>Önerilen Sipariş</th>
                <th>AI Risk</th>
               

            </tr>

        </thead>

        <tbody>

            @if (Model.Items.Any())
            {
                @foreach (var item in Model.Items)
                {
                    <tr>

                        <td>
                            @item.ProductName
                        </td>

                        <td>
                            @item.WarehouseName
                        </td>

                        <td>
                            @item.Quantity
                        </td>

                        <td>
                            @item.PredictedConsumption30Days
                        </td>
                        <td>

                            @if (item.RecommendedOrderQuantity > 0)
                            {
                                <span class="badge bg-primary">

                                    @item.RecommendedOrderQuantity Adet

                                </span>
                            }
                            else
                            {
                                <span class="text-success">

                                    Sipariş Gerekmiyor

                                </span>
                            }

                        </td>
                        <td>

                            @switch (item.RiskLevel)
                            {
                                case "High":
                                    <span class="badge bg-danger">
                                        🔴 Kritik
                                    </span>

                                    break;

                                case "Medium":

                                    <span class="badge bg-warning text-dark">
                                        🟠 Riskli
                                    </span>

                                    break;

                                default:

                                    <span class="badge bg-success">
                                        🟢 Güvenli
                                    </span>

                                    break;
                            }

                        </td>


                    </tr>
                }
            }
            else
            {
                <tr>

                    <td colspan="6"
                        class="text-center">

                        Kayıt bulunamadı

                    </td>

                </tr>
            }

        </tbody>

    </table>

</div>

@if (Model.TotalPages > 1)
{
    <nav class="mt-4">

        <ul class="pagination justify-content-center">

            <li class="page-item @(Model.PageNumber == 1 ? "disabled" : "")">

                <a class="page-link"
                   asp-action="Index"
                   asp-route-PageNumber="@(Model.PageNumber - 1)"
                   asp-route-PageSize="@Model.PageSize">

                    Önceki

                </a>

            </li>

            @for (int i = 1; i <= Model.TotalPages; i++)
            {
                <li class="page-item @(i == Model.PageNumber ? "active" : "")">

                    <a class="page-link"
                       asp-action="Index"
                       asp-route-PageNumber="@i"
                       asp-route-PageSize="@Model.PageSize">

                        @i

                    </a>

                </li>
            }

            <li class="page-item @(Model.PageNumber == Model.TotalPages ? "disabled" : "")">

                <a class="page-link"
                   asp-action="Index"
                   asp-route-PageNumber="@(Model.PageNumber + 1)"
                   asp-route-PageSize="@Model.PageSize">

                    Sonraki

                </a>

            </li>

        </ul>

    </nav>
}