@using System.Security.Claims

@{
    var userName =
        User.Identity?.Name ?? "Kullanıcı";

    var role =
        User.Claims
            .FirstOrDefault(x => x.Type == ClaimTypes.Role)
            ?.Value ?? "Rol Yok";

    var initials =
        string.Join(
            "",
            userName
                .Split(' ', StringSplitOptions.RemoveEmptyEntries)
                .Select(x => x[0]))
        .ToUpper();
}

<header class="topbar">

    <div>

        <h5 class="mb-0">
            Inventra
        </h5>

    </div>

    <div class="topbar-actions">

        <div class="notification-center">

            <button id="notificationButton"
                    class="notification-button"
                    type="button"
                    aria-expanded="false">

                🔔

                <span id="notificationCount"
                      class="notification-badge">

                    0

                </span>

                <span id="connectionIndicator"
                      class="connection-indicator"
                      data-state="disconnected">

                </span>

            </button>

            <div id="notificationPanel"
                 class="notification-panel d-none">

                <div class="notification-panel-header">

                    <div>

                        <strong>
                            Bildirimler
                        </strong>

                        <small>
                            Gerçek zamanlı bildirimler
                        </small>

                    </div>

                    <button id="clearNotifications"
                            class="notification-clear-button">

                        Temizle

                    </button>

                </div>

                <div id="notificationList"
                     class="notification-list">

                    <div class="notification-empty">

                        Henüz bildirim bulunmuyor

                    </div>

                </div>

            </div>

        </div>

        <div class="user-menu">

            <button id="userMenuButton"
                    type="button"
                    class="user-info">

                <div class="avatar">
                    @initials
                </div>

                <div>

                    <div>
                        @userName
                    </div>

                    <small>
                        @role
                    </small>

                </div>

            </button>

            <div id="userDropdown"
                 class="user-dropdown d-none">

                <a asp-controller="Profile"
                   asp-action="Index">

                    👤 Profilim

                </a>

                <a asp-controller="Profile"
                   asp-action="ChangePassword">

                    🔒 Şifre Değiştir

                </a>

                <hr />

                <a asp-controller="Auth"
                   asp-action="Logout">

                    🚪 Çıkış Yap

                </a>

            </div>

        </div>

    </div>

</header>

<div id="toastContainer"
     class="notification-toast-container">
</div>

<script>

    const userButton =
        document.getElementById("userMenuButton");

    const userDropdown =
        document.getElementById("userDropdown");

    userButton.addEventListener("click", function (e) {

        e.stopPropagation();

        userDropdown.classList.toggle("d-none");

    });

    document.addEventListener("click", function () {

        userDropdown.classList.add("d-none");

    });

</script>