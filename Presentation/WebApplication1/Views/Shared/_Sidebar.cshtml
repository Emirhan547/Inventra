<aside class="sidebar">

    <div class="logo">

        <h3>Inventra</h3>

        <span>Envanter Yönetim Sistemi</span>

    </div>

    <nav>

        <div class="menu-group">

            <span class="menu-title">
                GENEL
            </span>

            <a asp-controller="Dashboard"
               asp-action="Index">

                Gösterge Paneli

            </a>

        </div>

        @if (User.IsInRole("Admin"))
        {
            <div class="menu-group">

                <span class="menu-title">
                    YÖNETİM
                </span>

                <a asp-controller="User"
                   asp-action="Index">

                    Kullanıcılar

                </a>

                <a asp-controller="AuditLog"
                   asp-action="Index">

                    Denetim Kayıtları

                </a>

                <a asp-controller="Health"
                   asp-action="Index">

                    Sistem Durumu

                </a>

            </div>
        }

        @if (User.IsInRole("Admin") ||
             User.IsInRole("Manager"))
        {
            <div class="menu-group">

                <span class="menu-title">
                    TANIMLAR
                </span>

                <a asp-controller="Category"
                   asp-action="Index">

                    Kategoriler

                </a>

                <a asp-controller="Product"
                   asp-action="Index">

                    Ürünler

                </a>

                <a asp-controller="Supplier"
                   asp-action="Index">

                    Tedarikçiler

                </a>

                <a asp-controller="Warehouse"
                   asp-action="Index">

                    Depolar

                </a>

            </div>
        }

        @if (User.IsInRole("Admin") ||
             User.IsInRole("Manager") ||
             User.IsInRole("Employee"))
        {
            <div class="menu-group">

                <span class="menu-title">
                    STOK YÖNETİMİ
                </span>

                <a asp-controller="Stock"
                   asp-action="Index">

                    Stoklar

                </a>

                <a asp-controller="Stock"
                   asp-action="StockIn">

                    Stok Girişi

                </a>

                <a asp-controller="Stock"
                   asp-action="StockOut">

                    Stok Çıkışı

                </a>

                <a asp-controller="Stock"
                   asp-action="Transfer">

                    Stok Transferi

                </a>

                <a asp-controller="StockMovement"
                   asp-action="Index">

                    Stok Hareketleri

                </a>

            </div>
        }

        @if (User.IsInRole("Admin") ||
             User.IsInRole("Manager"))
        {
            <div class="menu-group">

                <span class="menu-title">
                    SATIN ALMA
                </span>

                <a asp-controller="PurchaseOrder"
                   asp-action="Index">

                    Satın Alma Siparişleri

                </a>

            </div>
        }

    </nav>

</aside>