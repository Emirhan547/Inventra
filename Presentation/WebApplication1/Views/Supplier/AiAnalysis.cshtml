@using Inventra.WebUI.Dtos.SupplierDtos

@model SupplierAiAnalysisDto

<div class="page-header">

    <div>

        <h2>

            🤖 AI Tedarikçi Analizi

        </h2>

        <p class="text-muted">

            OpenAI tarafından oluşturulan tedarikçi değerlendirmesi

        </p>

    </div>

</div>

<div class="dashboard-grid">

    <div class="content-card">

        <h4>AI Skoru</h4>

        <hr />

        <h1 class="display-3 text-primary">

            @Model.Score

        </h1>

    </div>

    <div class="content-card">

        <h4>Risk Seviyesi</h4>

        <hr />

        @switch (Model.RiskLevel)
        {
            case "High":

                <span class="badge bg-danger fs-6">

                    🔴 Yüksek Risk

                </span>

                break;

            case "Medium":

                <span class="badge bg-warning text-dark fs-6">

                    🟠 Orta Risk

                </span>

                break;

            default:

                <span class="badge bg-success fs-6">

                    🟢 Düşük Risk

                </span>

                break;
        }

    </div>

</div>

<div class="content-card mt-4">

    <h4>📋 AI Özeti</h4>

    <hr />

    <p>

        @Model.Summary

    </p>

</div>

<div class="dashboard-grid mt-4">

    <div class="content-card">

        <h4>✅ Güçlü Yönler</h4>

        <hr />

        <ul>

            @foreach (var item in Model.Strengths)
            {
                <li>@item</li>
            }

        </ul>

    </div>

    <div class="content-card">

        <h4>⚠️ Zayıf Yönler</h4>

        <hr />

        <ul>

            @foreach (var item in Model.Weaknesses)
            {
                <li>@item</li>
            }

        </ul>

    </div>

</div>

<div class="content-card mt-4">

    <h4>💡 AI Önerisi</h4>

    <hr />

    <div class="alert alert-primary">

        @Model.Recommendation

    </div>

</div>