
@using Inventra.WebUI.Dtos.ProfileDtos

@model ChangePasswordDto

<div class="page-header">

    <div>

        <h2>

            Şifre Değiştir

        </h2>

        <p class="text-muted">

            Hesabınızın güvenliği için güçlü bir şifre kullanın.

        </p>

    </div>

</div>

<form asp-action="ChangePassword"
      method="post">

    <div class="content-card">

        <div class="mb-3">

            <label asp-for="CurrentPassword"
                   class="form-label">

                Mevcut Şifre

            </label>

            <div class="input-group">

                <input asp-for="CurrentPassword"
                       id="currentPassword"
                       type="password"
                       class="form-control" />

                <button class="btn btn-outline-secondary"
                        type="button"
                        onclick="togglePassword('currentPassword', this)">

                    👁

                </button>

            </div>

            <span asp-validation-for="CurrentPassword"
                  class="text-danger">
            </span>

        </div>
        Yeni Şifre
        <div class="mb-3">

            <label asp-for="NewPassword"
                   class="form-label">

                Yeni Şifre

            </label>

            <div class="input-group">

                <input asp-for="NewPassword"
                       id="newPassword"
                       type="password"
                       class="form-control" />

                <button class="btn btn-outline-secondary"
                        type="button"
                        onclick="togglePassword('newPassword', this)">

                    👁

                </button>

            </div>

            <span asp-validation-for="NewPassword"
                  class="text-danger">
            </span>

        </div>
        Yeni Şifre Tekrar
        <div class="mb-4">

            <label asp-for="ConfirmPassword"
                   class="form-label">

                Yeni Şifre (Tekrar)

            </label>

            <div class="input-group">

                <input asp-for="ConfirmPassword"
                       id="confirmPassword"
                       type="password"
                       class="form-control" />

                <button class="btn btn-outline-secondary"
                        type="button"
                        onclick="togglePassword('confirmPassword', this)">

                    👁

                </button>

            </div>

            <span asp-validation-for="ConfirmPassword"
                  class="text-danger">
            </span>

        </div>
        Scripts
        @section Scripts
        {
            <partial name="_ValidationScriptsPartial" />

            <script>

                        function togglePassword(id, button) {

                            const input = document.getElementById(id);

                            if (input.type === "password") {

                                input.type = "text";

                                button.innerHTML = "🙈";
                            }
                            else {

                                input.type = "password";

                                button.innerHTML = "👁";
                            }

                        }

            </script>
        }

        <div class="d-flex gap-2">

            <button type="submit"
                    class="btn btn-warning">

                Şifreyi Güncelle

            </button>

            <a asp-action="Index"
               class="btn btn-secondary">

                Vazgeç

            </a>

        </div>

    </div>

</form>

<div class="content-card mt-4">

    <h5>

        Güvenlik Önerileri

    </h5>

    <hr />

    <ul class="mb-0">

        <li>

            En az 8 karakter kullanın.

        </li>

        <li>

            Büyük ve küçük harf birlikte kullanın.

        </li>

        <li>

            En az bir rakam ekleyin.

        </li>

        <li>

            Mümkünse özel karakter kullanın.

        </li>

        <li>

            Daha önce kullandığınız şifreleri tekrar kullanmayın.

        </li>

    </ul>

</div>

