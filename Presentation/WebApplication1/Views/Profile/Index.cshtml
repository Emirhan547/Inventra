
@using Inventra.WebUI.Dtos.ProfileDtos

@model ResultProfileDto

@{
    var avatarText =
        string.IsNullOrWhiteSpace(Model.FirstName)
            ? "?"
            : Model.FirstName.Trim()[0].ToString().ToUpper();
}

<div class="page-header">

    <div>

        <h2>
            Profilim
        </h2>

        <p class="text-muted">
            Hesap bilgilerinizi görüntüleyebilirsiniz.
        </p>

    </div>

</div>

@if (TempData["SuccessMessage"] is string successMessage &&
     !string.IsNullOrWhiteSpace(successMessage))
{
    <div class="alert alert-success">
        @successMessage
    </div>
}

<div class="row">

    <div class="col-lg-4">

        <div class="content-card text-center">

            <div class="profile-avatar">

                @avatarText

            </div>

            <h3 class="mt-3">

                @Model.FullName

            </h3>

            <p class="text-muted">

                @Model.UserName

            </p>

            <div class="mt-3">

                @foreach (var role in Model.Roles)
                {
                    <span class="badge bg-primary me-1">

                        @role

                    </span>
                }

            </div>

        </div>

    </div>

    <div class="col-lg-8">

        <div class="content-card">

            <h4>
                Kullanıcı Bilgileri
            </h4>

            <hr />

            <div class="row mb-3">

                <div class="col-md-6">

                    <label class="form-label">

                        Ad

                    </label>

                    <input class="form-control"
                           value="@Model.FirstName"
                           readonly />

                </div>

                <div class="col-md-6">

                    <label class="form-label">

                        Soyad

                    </label>

                    <input class="form-control"
                           value="@Model.LastName"
                           readonly />

                </div>

            </div>

            <div class="row mb-3">

                <div class="col-md-6">

                    <label class="form-label">

                        Kullanıcı Adı

                    </label>

                    <input class="form-control"
                           value="@Model.UserName"
                           readonly />

                </div>

                <div class="col-md-6">

                    <label class="form-label">

                        Email

                    </label>

                    <input class="form-control"
                           value="@Model.Email"
                           readonly />

                </div>

            </div>

        </div>

        <div class="content-card mt-4">

            <h4>
                Hesap İşlemleri
            </h4>

            <hr />

            <div class="d-flex gap-2">

                <a asp-action="Edit"
                   class="btn btn-primary">

                    Bilgileri Güncelle

                </a>

                <a asp-action="ChangePassword"
                   class="btn btn-warning">

                    Şifre Değiştir

                </a>

            </div>

        </div>

    </div>

</div>

